@startuml 01-use-case
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Account Owner" as Owner
actor "Scheduler (simulated)" as Scheduler

rectangle "DuePing System (CollectionFacade)" {
    usecase "Manage Clients & Projects" as UC_Clients
    usecase "Create, Update & Send Invoice" as UC_InvoiceLifecycle
    usecase "Import Invoices (CSV)" as UC_Import
    usecase "Record Payment" as UC_Payment
    usecase "Raise, Assign & Resolve Blocker" as UC_Blocker
    usecase "Suggest Next Action (Playbook)" as UC_PlaybookAction
    usecase "Record Payment Promise" as UC_Promise
    usecase "Log Follow-Up" as UC_FollowUp
    usecase "Attach / Remove Document" as UC_Document
    usecase "Generate & Mark Reminder Sent" as UC_Reminder
    usecase "View Prioritized Action Centre" as UC_ActionCenter
    usecase "Complete / Reschedule Action" as UC_ActionManage
    usecase "Run Daily Check" as UC_DailyCheck
    usecase "Detect Breached Promises & Overdue" as UC_DetectBreaches
    usecase "View Collections Dashboard & Aging" as UC_Dashboard
    usecase "View Audit Log & Notifications" as UC_AuditNotifications
    usecase "Write Off Invoice" as UC_WriteOff
    usecase "Time Travel & Demo Reset" as UC_SystemDemo
}

Owner --> UC_Clients
Owner --> UC_InvoiceLifecycle
Owner --> UC_Import
Owner --> UC_Payment
Owner --> UC_Blocker
Owner --> UC_Promise
Owner --> UC_FollowUp
Owner --> UC_Document
Owner --> UC_Reminder
Owner --> UC_ActionCenter
Owner --> UC_ActionManage
Owner --> UC_DailyCheck
Owner --> UC_Dashboard
Owner --> UC_AuditNotifications
Owner --> UC_WriteOff
Owner --> UC_SystemDemo

Scheduler --> UC_DailyCheck

UC_Blocker ..> UC_PlaybookAction : <<include>>
UC_DailyCheck ..> UC_DetectBreaches : <<include>>

@enduml
